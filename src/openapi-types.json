    "/api/v2/download/status": {
      "post": {
        "tags": [
          "Download Services"
        ],
        "summary": "Update File Status",
        "description": "The download/status function call is used to change the file status; either before being downloaded (set to “S” for started) and / or after a successful download (set to “C” for completed).<P>N = new; S = download started; X = download cancelled; C = download completed.",
        "operationId": "updateStatus",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              },
              "examples": {
                "Update to Completed": {
                  "summary": "download completed exmaple",
                  "description": "Update to Completed",
                  "value": {
                    "newstatus": "N",
                    "fileid": "9999"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
