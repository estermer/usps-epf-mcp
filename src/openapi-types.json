    "/api/v2/download/acslist": {
      "get": {
        "tags": [
          "Download Services"
        ],
        "summary": "ACS Only List of Files",
        "description": "The download/acslist function call is used to retrieve a list of all ACS files within scope for the user.<P><b>Note:</b> Multiple status parameters can be sent in the request or none to get all files.<br>N = new; S = download started; X = download cancelled; C = download completed.",
        "operationId": "acsList",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "N",
                  "C",
                  "S",
                  "X"
                ]
              }
            }
          },
          {
            "name": "fulfilledDate",
            "in": "query",
            "description": "Format:  YYYY-MM-DD",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Format:  YYYY-MM-DD"
            }
          },
          {
            "name": "productId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileListDefinition"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid Argument",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid Status Code": {
                    "summary": "Invalid status code is sent in request",
                    "description": "Invalid Status Code",
                    "value": {
                      "statusCode": 400,
                      "message": "Invalid Status Code"
                    }
                  }
                }
