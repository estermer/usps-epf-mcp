  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "UserAuthentication": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "pword": {
            "type": "string"
          }
        }
      },
      "AppUser": {
        "type": "object",
        "properties": {
          "logonkey": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "USER",
                "UPLOAD",
                "READONLY",
                "ADMIN"
              ]
            }
          }
        }
      },
      "StatusUpdate": {
        "type": "object",
        "properties": {
          "newstatus": {
            "type": "string",
            "description": "N = new; S = download started; X = download cancelled; C = download completed.",
            "enum": [
              "C",
              "N",
              "S",
              "X"
            ]
          },
          "fileid": {
            "type": "string"
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "string"
          },
          "messages": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "build": {
            "type": "string"
          }
        }
      },
      "FileListDefinition": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "fileId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "fulfilledDate": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64"
          },
          "productCode": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          }
        }
      }
    }
